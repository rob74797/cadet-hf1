{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadet-hf1",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadet-hf1",
      // Step 2 of the README: paste the Database ID from the Cloudflare dashboard here
      "database_id": "0085f3dd-6c3e-46e2-93bf-22dc23481e6f"
    }
  ],
  "observability": { "enabled": true }
}
